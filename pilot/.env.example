# Option A: Azure OpenAI (preferred; gpt-5.x deployments: leave LLM_TEMPERATURE unset)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Option B: OpenAI-compatible gateway (used only if AZURE_OPENAI_ENDPOINT is unset)
# OPENAI_BASE_URL=https://llm.example.com/v1
# OPENAI_API_KEY=
# LLM_MODEL=azure/gpt-5.4-nano

# Optional
# LLM_TEMPERATURE=0
# LLM_MAX_COMPLETION_TOKENS=2048
